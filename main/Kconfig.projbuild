menu "Roundie system"

config ROUNDIE_APP_RUNTIME
    bool "Enable the native application runtime, packages and launcher"
    default n
    depends on BOOTLOADER_APP_ROLLBACK_ENABLE
    help
        Application Executor, package registry and launcher. Independent of
        the development USB transports. Requires the REP partition layout.

config ROUNDIE_POWER
    bool "Enable screen off, the BOOT power menu and light sleep"
    default n
    help
        REP Section 17 PowerManager in normal mode. BOOT (GPIO0, input only)
        opens a menu with Sleep, Screen off, Restart, Safe Mode and Cancel.
        Light sleep wakes on touch INT or BOOT; USB Serial/JTAG disconnects
        while asleep. Safe Mode does not use it. No software power-off.

config ROUNDIE_POWER_SCREEN_TIMEOUT_SECONDS
    int "Seconds without touch or BOOT before the screen turns off"
    range 0 600
    default 30
    depends on ROUNDIE_POWER
    help
        0 disables automatic screen off. Rendering continues while dark.

config ROUNDIE_POWER_SLEEP_SAFETY_SECONDS
    int "Light-sleep safety timer in seconds"
    range 0 86400
    default 300
    depends on ROUNDIE_POWER
    help
        A timer wake after this long returns USB recovery with the screen off.
        Keeps a development board reachable if touch and BOOT wake fail.
        0 sleeps until touch or BOOT.

endmenu

menu "Roundie development diagnostics"

config ROUNDIE_RECOVERY_USB
    bool "Enable bounded USB Serial/JTAG recovery commands"
    default y
    depends on ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG
    help
        RS1 status and explicit guarded recovery operations. Shares the sole
        diagnostic reader. Does not enable RTC writes or firmware uploads.

config ROUNDIE_DEV_TIME_SYNC
    bool "Enable development USB Serial/JTAG RTC commands"
    default n
    depends on ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG
    help
        Allows a physically connected host to read RTC status and explicitly
        overwrite RTC UTC time. No authentication. Disable for production.

config ROUNDIE_DEV_OTA
    bool "Enable development USB Serial/JTAG OTA commands (unauthenticated)"
    default n
    depends on ROUNDIE_DEV_TIME_SYNC && BOOTLOADER_APP_ROLLBACK_ENABLE
    help
        Physically connected hosts may overwrite the inactive app slot and OTA
        metadata. Disable for production. Requires the REP partition layout.

config ROUNDIE_OTA_TEST_UNCONFIRMED_RESET
    bool "ARM one automatic rollback experiment in this development image"
    default n
    depends on ROUNDIE_DEV_OTA
    help
        DANGEROUS TEST IMAGE: never confirms itself. Only on PENDING_VERIFY
        with a verified VALID fallback, resets once to exercise automatic
        ABORTED rollback. Otherwise fails self-test without a reset loop.
        Requires separate hardware-test authorization. Never use for releases.

config ROUNDIE_DEV_ELF
    bool "Enable trusted development ELF staging and explicit execution"
    default n
    depends on ROUNDIE_DEV_OTA && ROUNDIE_APP_RUNTIME
    help
        RE1 bounded transfer to /storage/dev/hello.elf and explicit RUN by
        SHA-256. Trusted development code only; native code is unisolated.
        No discovery, autostart, packages, MTP or arbitrary path access.

config ROUNDIE_BOOT_GUARD_TEST
    bool "Enable bounded BootGuard development fault injection"
    default n
    depends on ROUNDIE_DEV_OTA
    help
        Adds RS1 FAULT with exact running ELF identity. Only a stable VALID
        image can arm three incomplete-boot software resets. Safe Mode cancels
        all remaining faults. Also adds RS1 HANG, which stops the system
        worker until its task watchdog panics, in any boot state including
        Safe Mode. Must use a version ending in -boot-test.
        Disable in normal firmware; never causes a fault merely by booting.

config ROUNDIE_DEV_POWER
    bool "Enable development USB Serial/JTAG power commands"
    default n
    depends on ROUNDIE_POWER && ROUNDIE_RECOVERY_USB
    help
        RW1 status, screen off/on and timed light sleep (1 to 3600 s).
        Unauthenticated; disable for production.

config ROUNDIE_DEV_PACKAGES
    bool "Enable trusted development RPK1 package management"
    default y
    depends on ROUNDIE_DEV_ELF
    help
        RP1 bounded package transport, explicit install, list, launch and remove.
        No authentication, signing, isolation or application autostart. Disable
        together with the other development interfaces for production; the
        launcher stays available through ROUNDIE_APP_RUNTIME.

config ROUNDIE_USB_STORAGE
    bool "USB storage mode: a FAT drive in PSRAM over USB-OTG mass storage"
    default n
    depends on ROUNDIE_APP_RUNTIME
    help
        Gate G2 of docs/usb-storage-mode-plan.md. A one-shot boot mode (RS1
        STORAGE) takes the internal USB PHY for mass storage and returns to
        USB Serial/JTAG with a planned restart. Normal mode is unchanged.

config ROUNDIE_DEV_STORAGE_CDC
    bool "Development: CDC status port in USB storage mode"
    default n
    depends on ROUNDIE_USB_STORAGE
    help
        Adds a CDC port that prints one status line a second and accepts the
        word EXITNOW to leave the mode. The USB Serial/JTAG diagnostics are
        off in this mode, so this is the only way to observe it from a host.
        Disable for production.

config ROUNDIE_BOOT_STABILITY_SECONDS
    int "BootGuard operational stability window (seconds)"
    range 5 30
    default 10

endmenu
