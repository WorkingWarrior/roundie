# Explicit target layout, never deploy through flash_bringup.py.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/rep.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ROUNDIE_DEV_OTA=y
# Reserve coredump space; enabling capture needs a separate measured gate.
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
# Measured display decision: see docs/display-o2-240-candidate.md.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Keeps the default 16 KB I-cache; a larger cache adds little under XIP.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ROUNDIE_APP_RUNTIME=y
CONFIG_ROUNDIE_DEV_ELF=y
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
# CONFIG_ELF_LOADER_LIBC_SYMBOLS is not set
# CONFIG_ELF_LOADER_ESPIDF_SYMBOLS is not set
# CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS is not set
# CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT is not set
# PowerManager: screen off, BOOT power menu, light sleep with a safety timer.
CONFIG_ROUNDIE_POWER=y
CONFIG_ROUNDIE_DEV_POWER=y

# Watch face and large labels (docs/watch-face.md)

# USB storage mode (docs/usb-storage-mode-plan.md, gate G2)
CONFIG_ROUNDIE_USB_STORAGE=y
CONFIG_ROUNDIE_DEV_STORAGE_CDC=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
# CONFIG_TINYUSB_MTP_ENABLED is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Speaker output (docs/audio.md)
CONFIG_ROUNDIE_AUDIO=y
CONFIG_ROUNDIE_DEV_AUDIO=y
