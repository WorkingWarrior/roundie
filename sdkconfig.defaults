# Waveshare ESP32-S3 Touch-LCD-1.85B: 16 MB flash, 8 MB Octal PSRAM.
# Common hardware settings; the default layout remains legacy bring-up.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# app_main owns the small LVGL loop and its rendering call stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Subscribe the GUI/main task in code. Panic/reboot if it cannot progress
# through a blocking panel-I/O call or the LVGL loop for 10 seconds.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# Explicitly enabled development interface; disable before production.
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ROUNDIE_DEV_TIME_SYNC=y
