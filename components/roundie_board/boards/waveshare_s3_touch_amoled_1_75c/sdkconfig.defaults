# Waveshare ESP32-S3-Touch-AMOLED-1.75C: 16 or 32 MB quad Flash, 8 MB Octal
# PSRAM. The image header says 16 MB, which boots on either chip (a larger
# chip is used up to the header size); see docs/hardware-audit-1.75c.md.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ROUNDIE_BOARD_WAVESHARE_S3_TOUCH_AMOLED_1_75C=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# No 32 kHz crystal is fitted; the RTC timer keeps time on the internal RC.
CONFIG_RTC_CLK_SRC_INT_RC=y
