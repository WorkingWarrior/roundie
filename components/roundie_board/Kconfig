menu "Roundie board"

choice ROUNDIE_BOARD
    prompt "Board support package (compile-time)"
    default ROUNDIE_BOARD_WAVESHARE_S3_TOUCH_LCD_1_85B
    help
        Selects the board implementation under components/roundie_board/boards.
        Must match the ROUNDIE_BOARD CMake variable, which also chooses the
        board's sdkconfig defaults. See docs/board-support.md.

config ROUNDIE_BOARD_WAVESHARE_S3_TOUCH_LCD_1_85B
    bool "Waveshare ESP32-S3-Touch-LCD-1.85B"
    depends on IDF_TARGET_ESP32S3
endchoice

config ROUNDIE_BOARD_DIR
    string
    default "waveshare_s3_touch_lcd_1_85b" if ROUNDIE_BOARD_WAVESHARE_S3_TOUCH_LCD_1_85B

if ROUNDIE_BOARD_WAVESHARE_S3_TOUCH_LCD_1_85B
rsource "boards/waveshare_s3_touch_lcd_1_85b/Kconfig"
endif

endmenu

menu "Roundie LCD"

config ROUNDIE_LCD_STRIP_LINES
    int "LVGL partial draw buffer height in lines"
    range 20 60
    default 20
    help
        Compile-time experiment; firmware accepts only 20 or 60. Each draw
        buffer and the SPI transfer limit use 720 bytes per line of internal
        DMA memory.

config ROUNDIE_LVGL_CORE_IRAM
    bool "Place the LVGL refresh and draw core in IRAM"
    default n
    help
        Compile-time experiment measuring Flash fetch cost. Uses internal
        memory for the objects listed in main/lvgl_iram.lf.

config ROUNDIE_LCD_DOUBLE_BUFFER
    bool "Two internal LVGL draw buffers"
    default y
    help
        Compile-time partial-render experiment. Adds one more buffer of
        internal DMA memory. LVGL renders the alternate buffer while the
        previous one transfers; one transfer remains outstanding. Queue depth
        stays two.

endmenu
