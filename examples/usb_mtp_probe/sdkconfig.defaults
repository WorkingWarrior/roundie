CONFIG_IDF_TARGET="esp32s3"
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
CONFIG_TINYUSB_MTP_ENABLED=y
CONFIG_TINYUSB_MTP_EP_BUFSIZE=4096
CONFIG_TINYUSB_MTP_MAX_STORAGES=1
CONFIG_TINYUSB_MTP_MAX_OBJECTS=32
# CONFIG_TINYUSB_MSC_ENABLED is not set
# CONFIG_TINYUSB_MTP_TRACE_WRITES is not set
